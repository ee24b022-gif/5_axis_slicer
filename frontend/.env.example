# Backend API base URL consumed by the frontend at build time.
# Required in production: set to the public backend URL, e.g.
#   VITE_API_BASE_URL=https://api.example.com
# VITE_API_BASE_URL takes precedence over VITE_API_URL. Neither is a hardcoded
# deployment URL - without either variable, requests are relative to the
# serving origin (/api).
VITE_API_BASE_URL=
VITE_API_URL=http://localhost:8001
VITE_ENV=development
