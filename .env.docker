# Docker Development Environment Configuration
# This file is used by docker-compose.yml for container services.
# Do NOT use this for local development — use .env instead.

APP_ENV=docker
DATABASE_URL=postgresql+psycopg://slicer_user:slicer_password@postgres:5432/slicer_db
REDIS_URL=redis://redis:6379/0
ARTIFACT_STORAGE_URI=file:///data/artifacts
SECRET_KEY=docker-dev-secret-key-not-for-production
WORKER_CONCURRENCY=2
ARTIFACT_RETENTION_DAYS=7
UPLOAD_LIMIT_MB=50
AUTH_MODE=local

AWS_DEFAULT_REGION=us-east-1
